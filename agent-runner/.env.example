# agent-runner — environment (export these; the runner reads process.env only,
# it never reads this file or any project .env). Copy values into your shell /
# secret manager. DO NOT commit real secrets.

# ServiceManager API base URL. MUST be an allowed, non-production host.
# Allowed by default: localhost, 127.0.0.1, 194.67.101.37 (stage).
SMA_API_BASE_URL="http://194.67.101.37:3001"

# Dedicated least-privilege service user (role ADMIN, email listed in the
# backend's ENGINEERING_AGENT_OWNER_EMAILS so it passes EngineeringAgentGuard).
SMA_AGENT_EMAIL="agent-runner@servicemanager.ai"
SMA_AGENT_PASSWORD=""

# Local Ollama model for read-only analysis (NO external AI API / keys).
OLLAMA_BASE_URL="http://172.17.0.1:11434"
OLLAMA_MODEL="qwen3.6:27b"

# Optional tuning (defaults shown).
POLL_INTERVAL_MS="15000"
TASK_TIMEOUT_MS="120000"

# Optional: extend the host allowlist (comma-separated). NEVER add production.
# ALLOWED_API_HOSTS=""
