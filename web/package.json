{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "prebuild": "node scripts/gen-support-qr.mjs",
    "predev": "node scripts/gen-support-qr.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:pwa-icons": "node scripts/gen-pwa-icons.mjs",
    "test:offline": "rm -rf .offline-test-build && tsc -p tsconfig.offline-tests.json && node --test .offline-test-build/mobile/offline/offline.test.js .offline-test-build/mobile/offline/cachePrefetch.test.js .offline-test-build/mobile/offline/appShellPrecache.test.js",
    "split:api": "node scripts/split-api-layer.mjs",
    "split:api:apply": "node scripts/split-api-layer.mjs --apply-barrel"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@tanstack/react-query": "5.100.9",
    "@types/qrcode": "1.5.6",
    "dijkstrajs": "1.0.3",
    "leaflet": "1.9.4",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "6.1.1",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.15.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.11",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "8.0.11"
  }
}
