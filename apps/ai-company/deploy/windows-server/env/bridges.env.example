# AI Company — runtime env for the Node bridges (copy to bridges.env, never commit).
# 03-install-services.ps1 passes every KEY=VALUE line to the NSSM services.

# GitHub Evidence Bridge (PR / checks as evidence). Fine-grained token, read-only:
# Contents: Read, Pull requests: Read, Checks: Read on the allowlisted repos.
GITHUB_TOKEN=
GITHUB_EVIDENCE_READER_MODE=github_api
GITHUB_EVIDENCE_REPOSITORY_ALLOWLIST=igormahachkala/servicemanager-ai-2.0
GITHUB_EVIDENCE_BRIDGE_HOST=127.0.0.1
GITHUB_EVIDENCE_BRIDGE_PORT=17320

# Connections Bridge (integration secrets; in-memory, lost on restart in V1)
CONNECTIONS_BRIDGE_HOST=127.0.0.1
CONNECTIONS_BRIDGE_PORT=17321

# Headless runs (scripts, night shift) reach Ollama directly — use localhost, NOT a raw IP.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_COMPANY_AUTO_APPROVE_SAFE_TOOLS=1

# Optional outbound proxy
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128

# Office server name(s) used to open the panel (IP always works)
# AI_COMPANY_ALLOWED_HOSTS=ai-server,ai-server.local
