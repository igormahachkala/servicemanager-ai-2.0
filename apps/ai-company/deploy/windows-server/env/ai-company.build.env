# AI Company — build-time config (Vite reads VITE_* at `vite build`).
# 02-clone-and-build.ps1 copies this file to apps/ai-company/.env.production.local.

VITE_AI_COMPANY_ENV=production
VITE_AI_COMPANY_DEPLOY_ENV=prod_server
VITE_AI_COMPANY_RUNTIME_PROVIDER=ollama

# The browser never talks to Ollama directly: it calls same-origin /runtime/ollama,
# and the web service (vite preview) relays to 127.0.0.1:11434 with Origin stripped.
# Leave VITE_TOOL_DISPATCHER_OLLAMA_BASE_URL UNSET — a raw LAN IP there is rejected
# by assertToolEndpointHasNoRawIp, and the same-origin relay is what works from any office PC.
VITE_AI_COMPANY_OLLAMA_ENDPOINT_MODE=localhost
VITE_AI_COMPANY_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_AI_COMPANY_OLLAMA_DEFAULT_MODEL=qwen3-coder:30b

# Autonomy: read-only tools (ollama analysis) skip Owner approval.
# Cursor (repo writes) ALWAYS waits for the Owner regardless of this flag.
VITE_AI_COMPANY_AUTO_APPROVE_SAFE_TOOLS=1
