# Copy to apps/ai-company/.env.local (gitignored). Do NOT commit real values.

# --- Browser-safe GitHub Evidence Reader config (no secrets) ---
VITE_GITHUB_EVIDENCE_READER_MODE=gh_cli
VITE_GITHUB_EVIDENCE_REPOSITORY_ALLOWLIST=owner/repository
VITE_GITHUB_EVIDENCE_MAX_BRANCHES=20
VITE_GITHUB_EVIDENCE_BRANCH_PREFIX=cursor/

# --- Server-side GitHub Evidence Bridge (trusted local runtime only) ---
GITHUB_EVIDENCE_READER_MODE=gh_cli
GITHUB_EVIDENCE_REPOSITORY_ALLOWLIST=owner/repository
GITHUB_EVIDENCE_MAX_BRANCHES=20
GITHUB_EVIDENCE_BRANCH_PREFIX=cursor/
GITHUB_EVIDENCE_BRIDGE_HOST=127.0.0.1
GITHUB_EVIDENCE_BRIDGE_PORT=17320

# Optional when mode=github_api (never use VITE_ prefix for tokens)
# GITHUB_TOKEN=ghp_***REDACTED***

# gh_cli mode: run `gh auth login` on the host — bridge does not perform interactive login.
