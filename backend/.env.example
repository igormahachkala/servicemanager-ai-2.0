# Local WSL runtime
# Copy to backend/.env for local backend start if the tracked default file is missing.
DATABASE_URL="postgresql://sma_user:sma_password@localhost:5432/sma_db?schema=public"
# REQUIRED. Must be ≥ 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
PORT=3000
# Comma-separated browser origins allowed to call the API.
# Production must include both the main app and the MAX Mini App origin:
#   https://servicemanagerai.ru,https://max.servicemanagerai.ru
# Keep Stage origins in Stage-specific compose/env files.
CORS_ALLOWED_ORIGINS="http://localhost:4173,http://127.0.0.1:4173"
PLATFORM_COMPANY_NAME="ServiceManager Platform"
PLATFORM_COMPANY_TIMEZONE="UTC"
PLATFORM_ADMIN_EMAIL="platform.admin@example.com"
PLATFORM_ADMIN_PASSWORD="ChangeMe123!"
PLATFORM_ADMIN_FIRST_NAME="Platform"
PLATFORM_ADMIN_LAST_NAME="Admin"
# Optional. Owner-only Engineering Agent module access (besides PLATFORM_ADMIN).
# Comma-separated emails. Empty/unset => only PLATFORM_ADMIN can access.
ENGINEERING_AGENT_OWNER_EMAILS=""
# Public frontend URL used to build ticket links inside MAX bot notifications.
# REQUIRED in production — if BOTH of the next two are empty, MAX messages are
# sent WITHOUT an "Открыть: <link>" line (runtime diagnostics log
# frontendUrlSource: 'missing'). MAX_PUBLIC_FRONTEND_URL wins over FRONTEND_URL.
# Production example: https://servicemanagerai.ru
# Link format produced: <url>/m/tickets/<ticketId>
FRONTEND_URL="http://localhost:4173"
MAX_PUBLIC_FRONTEND_URL=""
MAX_BOT_API_BASE_URL="https://platform-api.max.ru"
MAX_GROUP_CHAT_ID=""
MAX_BOT_API_TOKEN=""
MAX_BOT_COMMANDS_ENABLED=false
MAX_BOT_POLL_INTERVAL_MS=5000
MAX_BOT_POLL_TIMEOUT_SECONDS=5
MAX_BOT_WEBHOOK_ENABLED=false
MAX_BOT_WEBHOOK_URL=""
MAX_BOT_WEBHOOK_SECRET=""
# Web Push (mobile push notifications). Generate a DEV keypair locally with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# PROD keys are provisioned separately and MUST NOT be committed. Leave blank here.
# If unset, the /push endpoints respond but sending is disabled (vapid-public-key => empty).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
